# Optional Docker settings
# POSTGRES_PASSWORD=book_rhino
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=your-secret-password

# Extra hostnames Rails accepts in development besides localhost and IP
# addresses, for example a Tailscale MagicDNS name (comma-separated).
# RAILS_DEVELOPMENT_HOSTS=my-machine,my-machine.tailnet-name.ts.net
