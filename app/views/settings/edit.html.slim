= turbo_frame_tag 'settings_frame'
  = form_with(model: @settings, url: settings_path, method: :patch, local: true) do |form|
    - if @settings.errors.any?
      div id="error_explanation" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative"
        =r ux.h4
          = "#{pluralize(@settings.errors.count, "error")} prohibited this from being saved:"
        ul class="list-disc list-inside"
          - @settings.errors.full_messages.each do |message|
            li class="text-sm"= message

    =r ux.h3 text: 'Prompts'

    =r ux.divider '!mb-10'

    .field.flex.flex-col.mb-12
      = form.label :character_image_prompt, 'Character Image Generation Prompt', class: 'mb-6 text-gray-700 mt-4 font-bold'
      = form.text_area :character_image_prompt, class: 'form-input mt-1 block w-full rounded-md p-2 border-gray-300 font-mono text-sm',
              rows: 6, value: @settings.character_image_prompt

    .field.flex.flex-col.mb-12
      = form.label :character_pose_prompt, 'Character Pose Generation Prompt', class: 'mb-6 text-gray-700 mt-4 font-bold'
      = form.text_area :character_pose_prompt, class: 'form-input mt-1 block w-full rounded-md p-2 border-gray-300 font-mono text-sm',
              rows: 6, value: @settings.character_pose_prompt

    .field.flex.flex-col.mb-12
      = form.label :scene_background_prompt, 'Scene Background Generation Prompt', class: 'mb-6 text-gray-700 mt-4 font-bold'
      = form.text_area :scene_background_prompt, class: 'form-input mt-1 block w-full rounded-md p-2 border-gray-300 font-mono text-sm',
              rows: 6, value: @settings.scene_background_prompt

    .field.flex.flex-col.mb-12
      = form.label :location_background_prompt, 'Location Background Generation Prompt', class: 'mb-6 text-gray-700 mt-4 font-bold'
      = form.text_area :location_background_prompt, class: 'form-input mt-1 block w-full rounded-md p-2 border-gray-300 font-mono text-sm',
              rows: 6, value: @settings.location_background_prompt

    .field.flex.flex-col.mb-12
      = form.label :tunings, 'Tunings', class: 'mb-6 text-gray-700 mt-4 font-bold'
      = form.text_area :tunings, class: 'form-input mt-1 block w-full rounded-md p-2 border-gray-300',
              rows: 10, value: @settings.tunings, data: { controller: 'code' }

    .actions.flex.justify-between
      = form.submit class: 'py-2 px-4 bg-blue-500 text-white rounded-sm text-sm hover:bg-blue-600 border-solid border-2 border-gray-700 cursor-pointer'
      = link_to "Cancel", settings_path,
              class: 'py-2 px-4 bg-red-500 no-underline text-white rounded-sm text-sm hover:bg-red-700 hover:text-white border-solid border-2 border-gray-700'
