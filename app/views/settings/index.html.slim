=r ux.container
  =r ux.row
    =r ux.column width: 16
      =r ux.segment '!mt-10 !mb-20 !bg-zinc-100 !border-4 !border-zinc-200 !shadow-xl !px-10 !py-10 overflow-x-hidden'
        = turbo_frame_tag 'settings_frame'
          - if current_user.admin?
            div.mt-2.mb-8.text-right
              = link_to 'Edit Settings', edit_setting_path(@settings),
                      class: 'btn-primary'


          =r ux.code
            =r ux.h4 class: '!mb-8 dividing', text: 'Character Image Generation Prompt'
            pre.text-xs.mb-12
              = @settings.character_image_prompt.presence || 'None'

            =r ux.h4 class: '!mb-8 dividing', text: 'Character Pose Generation Prompt'
            pre.text-xs.mb-12
              = @settings.character_pose_prompt.presence || 'None'

            =r ux.h4 class: '!mb-8 dividing', text: 'Scene Background Generation Prompt'
            pre.text-xs.mb-12
              = @settings.scene_background_prompt.presence || 'None'

            =r ux.h4 class: '!mb-8 dividing', text: 'Tunings'
            pre.text-xs
              = @settings.tunings

