.location-image-card.bg-white.border-2.border-gray-300.rounded-sm.p-3.shadow-sm.flex.flex-col id=dom_id(location_image)
  .flex.items-center.justify-between.gap-2.mb-2
    .title-container.flex-1.min-w-0 data-controller="inline-edit" data-inline-edit-url-value=location_image_path(location_image.location, location_image) data-inline-edit-param-key-value="location_image"
      span.font-mono.text-xs.font-bold.text-gray-800.truncate.block.cursor-pointer.hover:text-blue-600.hover:underline title="Click to rename" data-inline-edit-target="display" data-action="click->inline-edit#startEditing"
        = location_image.title

      .hidden data-inline-edit-target="form"
        input.w-full.text-xs.font-mono.px-1.py-0.5.border-2.border-blue-400.rounded-xs type="text" value=location_image.title data-inline-edit-target="input" data-action="keydown->inline-edit#handleKeyDown blur->inline-edit#blurInput"

    .actions-container.flex.items-center.space-x-1.shrink-0
      div data-controller="copy-image" data-copy-image-image-url-value=(url_for(location_image.image) if location_image.image.attached?)
        button.btn-primary.text-xs class="!py-1 !px-2" type="button" data-copy-image-target="button" data-action="click->copy-image#copy" title="Copy image to clipboard"
          | Copy

      = button_to location_image_path(location_image.location, location_image), method: :delete, class: 'btn-list-delete !py-1 !px-2', data: { turbo_confirm: 'Are you sure you want to delete this image?' }, title: 'Delete image' do
        | &times;

  .image-preview-wrapper.w-full.h-64.bg-gray-100.rounded-sm.overflow-hidden.flex.items-center.justify-center.border.border-gray-200
    - if location_image.image.attached?
      = image_tag url_for(location_image.image), alt: location_image.title, class: 'w-full h-full object-contain'
    - else
      span.text-xs.text-gray-400 No image attached
